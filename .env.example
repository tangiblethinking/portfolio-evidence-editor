# Names only. Set real values as Sensitive env vars in the Vercel project (Production), never in the repo.
# Fine-grained PAT (github_pat_…): Resource owner tangiblethinking, Only select repositories: portforag-test,
# Repository permissions: Contents Read and write, Commit statuses Read-only (Metadata Read-only is automatic).
EDITOR_GITHUB_TOKEN=
# scrypt$N$r$p$salt$key from: node scripts/hash-password.mjs
EDITOR_PASSWORD_HASH=
# Random, at least 32 characters (e.g. openssl rand -base64 48)
EDITOR_SESSION_SECRET=
